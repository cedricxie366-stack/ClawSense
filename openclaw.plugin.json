{
  "id": "clawsense",
  "skills": [
    "skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "companionUrl": {
        "type": "string"
      },
      "companionTokenFile": {
        "type": "string"
      },
      "publicBaseUrl": {
        "type": "string"
      },
      "gatewayPort": {
        "type": "number"
      },
      "openaiApiKey": {
        "type": "string"
      },
      "openaiBaseUrl": {
        "type": "string"
      },
      "visionProvider": {
        "type": "string"
      },
      "visionModel": {
        "type": "string"
      },
      "embeddingModel": {
        "type": "string"
      },
      "embeddingDimensions": {
        "type": "number"
      },
      "retrievalEmbeddingBackend": {
        "type": "string"
      },
      "hostModelAudioMode": {
        "type": "string"
      },
      "hostModelImageMode": {
        "type": "string"
      },
      "hostModelVideoMode": {
        "type": "string"
      },
      "memoryDbPath": {
        "type": "string"
      },
      "memoryNamespace": {
        "type": "string"
      },
      "pairingTtlSeconds": {
        "type": "number"
      },
      "heartbeatIntervalSeconds": {
        "type": "number"
      },
      "maxPendingTokens": {
        "type": "number"
      },
      "artifactRetentionDays": {
        "type": "number"
      },
      "maxArtifactBytes": {
        "type": "number"
      },
      "mediaRoot": {
        "type": "string"
      },
      "analysisMode": {
        "type": "string"
      },
      "reviewModel": {
        "type": "string"
      },
      "sttFallbackModel": {
        "type": "string"
      },
      "localAsrBackend": {
        "type": "string"
      },
      "localAsrModelDir": {
        "type": "string"
      },
      "localAsrModelFile": {
        "type": "string"
      },
      "localAsrTokensFile": {
        "type": "string"
      },
      "localAsrLanguage": {
        "type": "string"
      },
      "localAsrNumThreads": {
        "type": "number"
      },
      "localAsrTimeoutMs": {
        "type": "number"
      },
      "localAsrCommand": {
        "type": "string"
      },
      "localAsrWhisperCommand": {
        "type": "string"
      },
      "localAsrWhisperModel": {
        "type": "string"
      },
      "localAsrFunAsrCommand": {
        "type": "string"
      },
      "localAsrFunAsrModel": {
        "type": "string"
      },
      "assistantQueryAudioKeepCount": {
        "type": "number"
      },
      "asrWorkerEnabled": {
        "type": "boolean"
      },
      "asrWorkerIntervalSeconds": {
        "type": "number"
      },
      "asrWorkerBatchSize": {
        "type": "number"
      },
      "asrWorkerMaxJobs": {
        "type": "number"
      },
      "asrWorkerLookbackDays": {
        "type": "number"
      },
      "asrWorkerProvider": {
        "type": "string"
      },
      "asrWorkerIncludeTranscribed": {
        "type": "boolean"
      },
      "primaryAgentContextScopes": {
        "type": "array",
        "description": "Optional explicit project/source/read scopes for the native OpenClaw agent. An empty array denies context access; omission preserves the legacy trusted host adapter.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "operations"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "encounterIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sourceKinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "audio",
                  "image",
                  "video",
                  "shared_text",
                  "shared_image",
                  "contact_selection"
                ]
              }
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read-metadata",
                  "read-analysis",
                  "read-raw",
                  "read-result"
                ]
              }
            }
          }
        }
      },
      "primaryAgentContextCapabilities": {
        "type": "array",
        "description": "Explicit mutation capabilities for a scoped native OpenClaw agent. Owner identity/result confirmations remain separate.",
        "items": {
          "type": "string",
          "enum": [
            "create-encounter",
            "update-encounter",
            "record-user-correction",
            "create-work",
            "complete-work",
            "reanalyze-evidence"
          ]
        }
      },
      "primaryAgentProcessingLocation": {
        "type": "string",
        "enum": [
          "local-only",
          "owned-devices",
          "selected-external"
        ],
        "description": "Owner-declared native agent processing boundary. Default is selected-external; this setting is not an independent offline audit."
      },
      "live": {
        "type": "object",
        "description": "Opt-in Live service configuration; disabled when omitted."
      }
    }
  }
}
