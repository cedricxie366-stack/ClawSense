{
  "name": "clawsense",
  "version": "0.1.0",
  "private": false,
  "description": "Always-on sensory companion plugin for OpenClaw",
  "homepage": "https://github.com/cedricxie366-stack/ClawSense",
  "bugs": {
    "url": "https://github.com/cedricxie366-stack/ClawSense/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricxie366-stack/ClawSense.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "install.sh",
    "dist/**/*.js",
    "skills/**/*.md",
    "openclaw.plugin.json",
    "package.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive:true, force:true })\" && tsc -p tsconfig.json",
    "check": "npm run build",
    "check:android-live": "bash ./scripts/check-android-live.sh",
    "check:android-live:doctor": "bash ./scripts/check-android-live.sh doctor",
    "check:android-live:fixtures": "bash ./scripts/check-android-live-fixtures.sh",
    "check:android-emulator:smoke": "bash ./scripts/check-android-emulator-smoke.sh run",
    "check:android-emulator:doctor": "bash ./scripts/check-android-emulator-smoke.sh doctor",
    "check:phase": "bash ./scripts/check-current-phase.sh",
    "check:phase9": "npm run build && node ./scripts/check-phase9-fixtures.mjs",
    "check:release": "bash ./scripts/check-release-boundary.sh",
    "check:stage-final": "bash ./scripts/check-stage-final.sh",
    "check:stage-final:doctor": "node ./scripts/check-stage-final-doctor.mjs",
    "check:stage-final:fixtures": "bash ./scripts/check-stage-final-fixtures.sh",
    "check:stage-final:index": "node ./scripts/index-stage-final-reports.mjs",
    "check:stage-final:live-guided": "bash ./scripts/run-final-live-validation.sh",
    "test": "vitest run --config vitest.config.ts",
    "log:dev": "bash ./scripts/dev-log.sh",
    "prepack": "npm run check && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@sinclair/typebox": "0.34.48",
    "openai": "^6.25.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.0"
  }
}
